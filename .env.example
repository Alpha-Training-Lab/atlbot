# Copy to .env and fill in. See README.md, "Environment variables".

# ----- Required -----
BOT_TOKEN=
GEMINI_API_KEY=
ONBOARDING_GROUP_ID=

# ----- Groups (send /chatid inside a group to get its id) -----
INDUCTION_GROUP_ID=
MAIN_GROUP_ID=
# Members of this group are automatically admins. Alpha must be an admin there.
LEADERSHIP_GROUP_ID=

# ----- Main-group gatekeeping -----
# Your own Telegram user id. Unset = nobody is removed from the main group.
OWNER_USER_ID=
# Where removed joiners are sent to start onboarding, e.g. the induction group link.
ONBOARDING_ENTRY_URL=

# ----- Optional -----
INDUCTION_GROUP_PINNED_MESSAGE=
REQUIRED_TAGS=@ShemmyCypher,@Dr_evidence,@Epitome61
# MIN_INDUCTION_SECONDS=864000
# ATL_DB_PATH=atl_bot.db

# ----- scripts/backup_db.py -----
ATL_BACKUP_BUCKET=
